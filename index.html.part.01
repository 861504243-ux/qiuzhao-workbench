:root{--paper:#F4F1EA;--world:#1F4A37;--accent:#2F6B4F;--accent-soft:rgba(47,107,79,.12);--ink:#223B31;--muted:#7C877F;--line:rgba(34,59,49,.14);--ok:#2F7D6D;--warn:#C87F2A;--danger:#B5483A;--disabled:#B9C2BC;--radius:6px;--row:44px;--serif:Georgia,'Times New Roman',serif}*{box-sizing:border-box;margin:0;padding:0}html,body{height:100%}body{background:var(--paper);color:var(--ink);font:14px/1.55 -apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;overflow:hidden}.app{display:grid;grid-template-columns:228px 1fr;height:100vh}.side{background:var(--world);color:#EAF2EC;display:flex;flex-direction:column;padding:20px 14px;gap:4px}.brand{display:flex;align-items:center;gap:10px;padding:2px 8px 18px}.brand .logo{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#3E8A68,#1F4A37);display:grid;place-items:center;color:#fff}.brand h1{font-size:16px;letter-spacing:.02em}.brand small{display:block;font-size:10px;color:#A9C4B2;margin-top:2px}.nav{display:flex;flex-direction:column;gap:2px}.nav a{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;color:#CBE0D2;text-decoration:none;font-size:13px;cursor:pointer}.nav a:hover{background:rgba(255,255,255,.07)}.nav a.on{background:var(--accent);color:#fff;font-weight:600}.nav .dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.85}.side .foot{margin-top:auto;font-size:11px;color:#8FAE9C;padding:10px 10px 0;border-top:1px solid rgba(255,255,255,.08)}.main{display:flex;flex-direction:column;min-width:0}.top{height:56px;border-bottom:1px solid var(--line);background:rgba(244,241,234,.9);display:flex;align-items:center;padding:0 20px;gap:16px}.top .crumb{font-size:13px;color:var(--muted)}.top .spacer{flex:1}.top .state-btn{padding:6px 12px;border:1px solid var(--line);border-radius:20px;background:#fff;font-size:12px;color:var(--ink);cursor:pointer}.top .state-btn.on{background:var(--accent);color:#fff;border-color:var(--accent)}.view{flex:1;overflow-y:auto;padding:22px 26px}.band{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:end;background:linear-gradient(135deg,#1F4A37,#2F6B4F);color:#F4F1EA;border-radius:14px;padding:18px 22px;margin-bottom:20px;position:relative;overflow:hidden}.band:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 85% 20%,rgba(255,255,255,.10),transparent 55%)}.band h2{font-size:19px;letter-spacing:.01em}.band p{font-size:12px;color:#C9DDD1;margin-top:4px}.band .big{font-family:var(--serif);font-size:38px;line-height:1;font-weight:700;color:#fff}.band .big small{font-size:13px;color:#A9C4B2;font-family:sans-serif;font-weight:400}.radar-svg{position:absolute;right:-8px;top:-10px;opacity:.5;animation:radarspin 8s linear infinite}.grid{display:grid;gap:16px}.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}.card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:16px}.card h3{font-size:14px;margin-bottom:12px;display:flex;align-items:center;gap:8px}.card h3 .tag{margin-left:auto}.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px 16px}.kpi .n{font-family:var(--serif);font-size:30px;font-weight:700;color:var(--world)}.kpi .l{font-size:12px;color:var(--muted);margin-top:2px}.chip{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:20px;font-size:12px;background:var(--accent-soft);color:var(--accent);border:1px solid rgba(47,107,79,.22)}.chip.warn{background:#FBF1E3;color:#B26A16;border-color:rgba(192,127,42,.3)}.chip.danger{background:#F8E7E2;color:#A03A2E;border-color:rgba(181,72,58,.3)}.chip.off{background:#EEF0EE;color:#8A948E;border-color:rgba(138,148,142,.25)}.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1px solid var(--line);background:#fff;font-size:13px;color:var(--ink);cursor:pointer}.btn.pri{background:var(--accent);color:#fff;border-color:var(--accent)}.btn.pri:hover{background:#2A5F46}.btn.sm{padding:5px 10px;font-size:12px}.filter-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:center}.filter-row select,.filter-row input{padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;font-size:13px;color:var(--ink)}.job-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.job{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:14px;cursor:pointer;transition:box-shadow .15s}.job:hover{box-shadow:0 4px 14px rgba(31,74,55,.12)}.job .co{font-weight:600;font-size:14px;display:flex;gap:6px;align-items:center}.job .co .ic{width:22px;height:22px;border-radius:6px;background:var(--world);color:#fff;display:grid;place-items:center;font-size:11px}.job .pos{font-size:13px;margin-top:6px}.job .meta{font-size:12px;color:var(--muted);margin-top:8px;display:flex;flex-wrap:wrap;gap:4px}.timeline{position:relative;padding-left:22px}.timeline:before{content:'';position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:var(--line)}.tl-item{position:relative;padding:8px 12px;margin-bottom:8px;background:#fff;border:1px solid var(--line);border-radius:8px;border-left:3px solid var(--ok)}.tl-item.warn{border-left-color:var(--warn)}.tl-item.danger{border-left-color:var(--danger)}.tl-item:before{content:'';position:absolute;left:-21px;top:14px;width:9px;height:9px;border-radius:50%;background:var(--ok);border:2px solid var(--paper)}.tl-item.warn:before{background:var(--warn)}.tl-item.danger:before{background:var(--danger)}.tl-item .d{font-family:var(--serif);font-size:20px;color:var(--world)}.tl-item .c{font-size:13px;font-weight:600}.tl-item .m{font-size:12px;color:var(--muted);margin-top:2px}.state{display:grid;place-items:center;min-height:200px;color:var(--muted);font-size:13px}.state .spin{width:26px;height:26px;border:3px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:rot 1s linear infinite}@keyframes rot{to{transform:rotate(360deg)}}@keyframes radarspin{to{transform:rotate(360deg)}}